@model Library_Management.Models.Author

<h2>Delete Author</h2>

<h4>Are you sure you want to delete this author?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Biography</dt>
        <dd class="col-sm-10">@Model.Biography</dd>

        <dt class="col-sm-2">Birthdate</dt>
        <dd class="col-sm-10">@Model.Birthdate?.ToShortDateString()</dd>

        <dt class="col-sm-2">Profile Image</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="@Model.Name" style="max-height:150px;" />
            }
        </dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="AuthorId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
