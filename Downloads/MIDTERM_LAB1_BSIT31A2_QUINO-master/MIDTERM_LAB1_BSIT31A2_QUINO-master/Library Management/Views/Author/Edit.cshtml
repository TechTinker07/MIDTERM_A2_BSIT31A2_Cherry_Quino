@model Library_Management.Models.Author

<h2>Edit Author</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="AuthorId" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Biography" class="form-label"></label>
        <textarea asp-for="Biography" class="form-control"></textarea>
        <span asp-validation-for="Biography" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Birthdate" class="form-label"></label>
        <input asp-for="Birthdate" type="date" class="form-control" />
        <span asp-validation-for="Birthdate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProfileImageUrl" class="form-label"></label>
        <input asp-for="ProfileImageUrl" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
